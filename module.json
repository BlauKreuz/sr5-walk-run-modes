{
  "id": "sr5-walk-run-modes",
  "title": "SR5 Walk/Run Mode Declaration",
  "description": "Adds per-initiative-phase and per-turn walk/run/sprint mode declaration to Combat Tracker. Enforces movement distance limits based on the declared mode and cumulative movement across all initiative passes during the whole combat turn. Includes an option to add automatic Active Effects modifiers to dice pools for running and sprinting. (>> Requires the sr5-ae-neg-filter module.)",
  "version": "0.2",
  "authors": [
    {
      "name": "Kurko"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "url": "https://github.com/BlauKreuz/sr5-walk-run-modes",
  "manifest": "https://github.com/BlauKreuz/sr5-walk-run-modes/releases/download/v0.2/module.json",
  "download": "https://github.com/BlauKreuz/sr5-walk-run-modes/releases/download/v0.2/sr5-walk-run-modes-v0.2.zip",

  "esmodules": [
    "scripts/main.js",
    "scripts/combat-tracker.js",
    "scripts/lifecycle.js",
    "scripts/movement.js",
    "scripts/settings.js",
    "scripts/ruler.js",
    "scripts/utils.js"
  ],
  "styles": [
    "styles/sr5-walk-run-modes.css"
  ],   
  "relationships": {
    "requires": [
      {
        "id": "shadowrun5e",
        "type": "system",
        "manifest": "https://raw.githubusercontent.com/SR5-FoundryVTT/SR5-FoundryVTT/master/system.json",
        "compatibility": {
          "minimum": "0.36.2"
        }
      }
    ]
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ]
}
